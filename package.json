{
  "name": "aerogate-website",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 3D airport website that walks passengers through the full boarding flow — built with Next.js, React Three Fiber, GSAP and Matter.js.",
  "author": "Reivan Elsyafir Pratama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x4zu/AeroGate-Website.git"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "build:models": "node scripts/build-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.6.0",
    "matter-js": "^0.20.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
